{
  "id": "car-latest-satellite-image",
  "version": "1.0.0",
  "name": "Imagem de satélite mais recente do imóvel CAR",
  "description": "A imagem Sentinel-2 mais recente e com poucas nuvens sobre o imóvel, em cor verdadeira, com os mapas e as estatísticas de NDVI, EVI, NDMI e NDRE calculados com as fórmulas do Satellite Hub.",
  "category": "Monitoramento",
  "inputs": [
    { "name": "codImovel", "type": "string", "required": true, "label": "Código do imóvel no CAR" }
  ],
  "flow": {
    "nodes": [
      { "id": "property", "block": "car-property" },
      { "id": "geometry", "block": "car-property-geometry" },
      { "id": "image", "block": "sathub-latest-image", "values": { "indices": "ndvi,evi,ndmi,ndre" } }
    ],
    "connections": [
      { "from": "inputs.codImovel", "to": "property.codImovel" },
      { "from": "inputs.codImovel", "to": "geometry.codImovel" },
      { "from": "geometry.geometry", "to": "image.geometry" }
    ]
  },
  "templateHtmlFile": "car-latest-satellite-image.html",
  "templateCssFile": "report-base.css",
  "page": { "size": "A4", "orientation": "portrait", "marginMm": 18 }
}
